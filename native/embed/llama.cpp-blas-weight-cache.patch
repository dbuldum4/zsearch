diff --git a/ggml/src/ggml-blas/ggml-blas.cpp b/ggml/src/ggml-blas/ggml-blas.cpp
index 6feb370..c6d025b 100644
--- a/ggml/src/ggml-blas/ggml-blas.cpp
+++ b/ggml/src/ggml-blas/ggml-blas.cpp
@@ -7,4 +7,6 @@
 #include <vector>
 #include <cstring>
+#include <unordered_map>
+#include <cstdlib>

 #if defined(GGML_BLAS_USE_ACCELERATE)
@@ -24,4 +26,12 @@ struct ggml_backend_blas_context {
     std::unique_ptr<char[]> work_data;
     size_t work_size = 0;
+#if defined(GGML_BLAS_USE_ACCELERATE)
+    // Model buffers are immutable for this inference context. Decode each weight once,
+    // instead of launching conversion threads again on every batch and every layer.
+    struct weight { std::vector<float> values; bool ready = false; };
+    std::unordered_map<const ggml_tensor *, weight> weights;
+    size_t weights_bytes = 0;
+    static constexpr size_t weights_budget = 512ull << 20;
+#endif
 #ifndef GGML_USE_OPENMP
     std::vector<std::future<void>> tasks;
@@ -59,12 +69,42 @@ static void ggml_backend_blas_mul_mat(ggml_backend_blas_context * ctx, struct gg
     const size_t  desired_wsize = type == GGML_TYPE_F32 ? 0 : ne03*ne02*ne_plane*sizeof(float);

-    if (ctx->work_size < desired_wsize) {
-        ctx->work_data.reset(new char[desired_wsize]);
-        ctx->work_size = desired_wsize;
+#ifndef GGML_USE_OPENMP
+    // Finish any conversion left by an interrupted/failed graph before reusing its buffers.
+    for (auto & task : ctx->tasks) task.get();
+    ctx->tasks.clear();
+#endif
+    void * wdata = nullptr;
+    bool convert = type != GGML_TYPE_F32;
+#if defined(GGML_BLAS_USE_ACCELERATE)
+    ggml_backend_blas_context::weight * decoded = nullptr;
+    const bool immutable = src0->buffer &&
+        ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+        src0->op == GGML_OP_NONE;
+    if (convert && immutable && !getenv("ZSEARCH_EMBED_NO_BLAS_CACHE")) {
+        auto cached = ctx->weights.find(src0);
+        if (cached != ctx->weights.end()) {
+            decoded = &cached->second;
+            wdata = decoded->values.data();
+            convert = !decoded->ready;
+        } else if (desired_wsize <= ctx->weights_budget - ctx->weights_bytes) {
+            // Allocate before publishing the entry: failed allocation must not leave a cache hit.
+            ggml_backend_blas_context::weight entry;
+            entry.values.resize(desired_wsize / sizeof(float));
+            decoded = &ctx->weights.emplace(src0, std::move(entry)).first->second;
+            wdata = decoded->values.data();
+            ctx->weights_bytes += desired_wsize;
+        }
+    }
+#endif
+    if (!wdata && desired_wsize) {
+        if (ctx->work_size < desired_wsize) {
+            ctx->work_data.reset(new char[desired_wsize]);
+            ctx->work_size = desired_wsize;
+        }
+        wdata = ctx->work_data.get();
     }
-    void * wdata = ctx->work_data.get();

     // convert src0 to float
-    if (type != GGML_TYPE_F32) {
+    if (convert) {
         const auto * type_traits = ggml_get_type_traits(type);
         ggml_to_float_t const to_float = type_traits->to_float;
@@ -114,4 +154,7 @@ static void ggml_backend_blas_mul_mat(ggml_backend_blas_context * ctx, struct gg
         }
         ctx->tasks.clear();
+#endif
+#if defined(GGML_BLAS_USE_ACCELERATE)
+        if (decoded) decoded->ready = true;
 #endif
     }
