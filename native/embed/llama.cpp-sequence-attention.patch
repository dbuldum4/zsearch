+// Lengths of independent, contiguous sequence runs. Shared/interleaved token sets use the dense path.
+static std::vector<int64_t> independent_sequence_lengths(const llama_ubatch & batch) {
+    std::vector<int64_t> lengths;
+    std::unordered_set<llama_seq_id> seen;
+    llama_seq_id previous = -1;
+    for (uint32_t i = 0; i < batch.n_tokens; ++i) {
+        if (batch.n_seq_id[i] != 1) return {};
+        const auto id = batch.seq_id[i][0];
+        if (id != previous) {
+            if (!seen.insert(id).second) return {};
+            lengths.push_back(0);
+            previous = id;
+        }
+        ++lengths.back();
+    }
+    return lengths;
+}
+
+bool llm_graph_input_attn_no_cache::can_reuse(const llm_graph_params & params) {
+    // The views baked into a split graph must follow the new batch's exact boundaries.
+    return sequence_lengths.empty() || sequence_lengths == independent_sequence_lengths(params.ubatch);
+}
