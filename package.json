{
  "name": "zsearch",
  "version": "0.1.0",
  "description": "Fast file search for your terminal: names, contents (PDF, Office, code, text) with fuzzy, exact and regex modes.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "zsearch": "./bin/zsearch.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit -p . --noUnusedLocals --noUnusedParameters",
    "build": "bun run scripts/build.ts",
    "fixtures": "python3 scripts/make-fixtures.py test/fixtures",
    "bench": "bun run scripts/bench.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "ignore": "7.0.12",
    "solid-js": "1.9.12",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "5"
  }
}
